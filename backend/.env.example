# Copy to ../qa-platform/.env. Keep these values private and stable.
# Generate QA_AI_ENCRYPTION_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
QA_ADMIN_PASSWORD=replace-with-unique-password-at-least-12-characters
QA_AI_ENCRYPTION_KEY=replace-with-64-hex-character-key
# Optional PostgreSQL connection URL. Set only after creating the managed database.
# QA_PLATFORM_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require
# Optional CORS origins when the frontend is served separately (comma-separated, no trailing slash).
# QA_CORS_ORIGINS=http://127.0.0.1:3000
