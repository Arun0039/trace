# Copy to .env and keep private. Never commit the real file.
HOST=0.0.0.0
PORT=8001
QA_HOST=0.0.0.0
QA_PORT=8001
QA_ENVIRONMENT=production

# Database
# Local SQLite (default if unset): qa-platform/qa_platform.sqlite3
# Managed PostgreSQL with TLS:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Required secrets
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
QA_ADMIN_PASSWORD=
QA_AI_ENCRYPTION_KEY=

# CORS / frontend (only when the frontend is served from another origin)
FRONTEND_URL=
CORS_ORIGINS=
QA_CORS_ORIGINS=

# Auth
# true is required for cloud/public deployments; false restricts sign-in to loopback.
QA_ALLOW_PUBLIC_AUTH=true
# Set true when the app is served over HTTPS (Render sets X-Forwarded-Proto automatically).
QA_COOKIE_SECURE=true
QA_TRIAL_DURATION_DAYS=14

# Optional limits and retention
QA_STORAGE_QUOTA_MB=
QA_DEVELOPER_ERROR_RETENTION_DAYS=90

# AI (optional)
OLLAMA_HOST=http://localhost:11434
