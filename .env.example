# App configuration
APP_ENV=production
HOST=0.0.0.0
PORT=8001
QA_HOST=0.0.0.0
QA_PORT=8001

# Database
# For local SQLite (default if not set): uses qa-platform/qa_platform.sqlite3
# For PostgreSQL/Render/Neon:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Secrets
# Generate a stable 64-hex key for AI encryption
QA_AI_ENCRYPTION_KEY=
SECRET_KEY=

# CORS / Frontend
FRONTEND_URL=
CORS_ORIGINS=
QA_CORS_ORIGINS=

# Auth
QA_ALLOW_PUBLIC_AUTH=true
ALLOW_PUBLIC_AUTH=true

# Storage
FILE_STORAGE=local

# AI (optional)
OLLAMA_HOST=http://localhost:11434
